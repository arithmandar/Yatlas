<Ui xmlns="http://www.blizzard.com/wow/ui/" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
	<Script file="Button.lua"/>

	<Frame name="YatlasButtonFrame" parent="Minimap" enableMouse="true" hidden="false" frameStrata="LOW">
		<Size>
			<AbsDimension x="32" y="32"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="Minimap" relativePoint="RIGHT">
				<Offset>
					<AbsDimension x="2" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Button name="TheYatlasButton">
				<Size>
					<AbsDimension x="31" y="31"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<!-- the round minimap button look of the game's own tracking button: background,
				     icon and border ring; sizes and offsets are set per client in YatlasButton_SetupLook -->
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Background" file="Interface\Minimap\UI-Minimap-Background"/>
					</Layer>
					<Layer level="ARTWORK">
						<Texture parentKey="Icon" file="Interface\WorldMap\WorldMap-Icon"/>
					</Layer>
					<Layer level="OVERLAY">
						<Texture parentKey="Border" file="Interface\Minimap\MiniMap-TrackingBorder"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						self:RegisterForDrag("RightButton");
						self.dragme = false;
						YatlasButton_SetupLook(self);
					</OnLoad>
					<OnMouseDown>
						YatlasButton_SetPressed(self, true);
					</OnMouseDown>
					<OnMouseUp>
						YatlasButton_SetPressed(self, false);
					</OnMouseUp>
					<OnDragStart> 
						self.dragme = true;
						self:LockHighlight() 
					</OnDragStart> 
					<OnDragStop>
						self.dragme = false;
						self:UnlockHighlight() 
					</OnDragStop>
					<OnUpdate>
						if(self.dragme == true) then
							YatlasButton_BeingDragged();
						end
					</OnUpdate>
					<OnClick>
						YatlasButton_OnClick();
					</OnClick>
					<OnEnter>
						YatlasButton_OnEnter(self);
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide();
					</OnLeave>
				</Scripts>
				<HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				self:RegisterEvent("VARIABLES_LOADED");
			</OnLoad>
			<OnEvent>
				YatlasButton_OnEvent(event, ...);
			</OnEvent>
		</Scripts>
	</Frame>

</Ui>
